class _FieldManagementPageState extends State<FieldManagementPage> {
  final supabase = Supabase.instance.client;

  final fieldController = TextEditingController();
  final fieldIdController = TextEditingController();

  bool saving = false;
List<Map<String, dynamic>> assignments = [];
bool loadingAssignments = true;

Future<void> _loadAssignments() async {
  try {
    final response = await supabase
        .from('device_assignments')
        .select()
        .order('updated_at', ascending: false);

    if (!mounted) return;

    setState(() {
      assignments =
          List<Map<String, dynamic>>.from(response);
      loadingAssignments = false;
    });
  } catch (e) {
    if (!mounted) return;

    setState(() {
      loadingAssignments = false;
    });
  }
}

@override
void initState() {
  super.initState();
  _loadAssignments();
}
  @override
  void dispose() {
    fieldController.dispose();
  fieldIdController.dispose();
    super.dispose();
  }

  Future<void> _saveAssignment() async {
    final fieldName = fieldController.text.trim();
    final fieldId = fieldIdController.text.trim();

    if (fieldName.isEmpty || fieldId.isEmpty) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('Kon nomi va Kon ID sini kiriting'),
        ),
      );
      return;
    }

    setState(() {
      saving = true;
    });

    try {
      await supabase.from('device_assignments').upsert(
        {
          'field_id': fieldId,
          'field_name': fieldName,
          'updated_at': DateTime.now().toIso8601String(),
        },
        onConflict: 'field_id',
      );

      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('Kon qurilmaga biriktirildi'),
        ),
      );

      fieldController.clear();
      fieldIdController.clear();
await _loadAssignments();
    } catch (e) {
      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text('Saqlashda xato: $e'),
        ),
      );
    } finally {
      if (mounted) {
        setState(() {
          saving = false;
        });
      }
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Konlarni boshqarish'),
      ),
      body: ListView(
