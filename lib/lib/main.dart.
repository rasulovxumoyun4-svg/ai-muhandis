                                '${item['alarm'] ?? '-'}',
                              ),
                              const Divider(),
                              Text(
                                'Sabab: '
                                '${item['cause'] ?? '-'}',
                              ),
                              Text(
                                'Bajarilgan ish: '
                                '${item['work_done'] ?? '-'}',
                              ),
                              Text(
                                'Almashtirilgan qism: '
                                '${item['part'] ?? '-'}',
                              ),
                              Text(
                                'Natija: '
                                '${item['result'] ?? '-'}',
                              ),
                              const Divider(),
                              Text(
                                'Muhandis: '
                                '${item['engineer'] ?? '-'}',
                              ),
                              Text(
                                'Bo‘lim: '
                                '${item['department'] ?? '-'}',
                              ),
                              Text(
                                'Holat: '
                                '${_statusText(item['status'])}',
