class _ManagerPageState extends State<ManagerPage> {
  final supabase = Supabase.instance.client;

  List<Map<String, dynamic>> works = [];
  bool loading = true;

  @override
  void initState() {
    super.initState();
    _loadWorks();
  }

  Future<void> _loadWorks() async {
    try {
      var query = supabase
    .from('fault_history')
    .select();

if (!AppSession.isSuperAdmin &&
    AppSession.fieldId != null &&
    AppSession.fieldId!.isNotEmpty) {
  query = query.eq('field_id', AppSession.fieldId!);
}

final response =
    await query.order('created_at', ascending: false);

      if (!mounted) return;

      setState(() {
        works = List<Map<String, dynamic>>.from(response);
        loading = false;
      });
    } catch (e) {
      if (!mounted) return;

      setState(() {
        loading = false;
      });

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(
            'Rahbar panelini yuklashda xato: $e',
          ),
        ),
      );
    }
  }

  int _countStatus(String status) {
    return works.where((item) {
      return item['status']?.toString() == status;
    }).length;
  }

  Widget _statusCard(
    String title,
    int count,
    IconData icon,
  ) {
    return Card(
      child: Padding(
        padding: const EdgeInsets.all(16),
        child: Row(
          children: [
            CircleAvatar(
              child: Icon(icon),
            ),
            const SizedBox(width: 14),
            Expanded(
              child: Text(
                title,
                style: const TextStyle(
                  fontWeight: FontWeight.bold,
                ),
              ),
            ),
            Text(
              '$count',
              style: const TextStyle(
                fontSize: 24,
                fontWeight: FontWeight.bold,
              ),
            ),
          ],
        ),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
final currentField = AppSession.fieldName ?? 'Barcha konlar';
    final open = _countStatus('open');
    final inProgress = _countStatus('in_progress');
    final completed = _countStatus('completed');

    return Scaffold(
      appBar: AppBar(
    title: Text('Rahbar paneli — $currentField'),
        actions: [
          IconButton(
            onPressed: _loadWorks,
            icon: const Icon(Icons.refresh),
          ),
        ],
      ),
      body: loading
          ? const Center(
              child: CircularProgressIndicator(),
            )
          : RefreshIndicator(
              onRefresh: _loadWorks,
              child: ListView(
                padding: const EdgeInsets.all(16),
                children: [
                  _statusCard(
                    'Ochiq nosozliklar',
                    open,
                    Icons.warning_amber,
                  ),
                  _statusCard(
                    'Jarayondagi ishlar',
                    inProgress,
                    Icons.build,
                  ),
                  _statusCard(
                    'Yakunlangan ishlar',
                    completed,
                    Icons.check_circle_outline,
                  ),
                  _statusCard(
                    'Jami yozuvlar',
                    works.length,
                    Icons.list_alt,
                  ),

                  const SizedBox(height: 20),

                  const Text(
                    'So‘nggi ishlar',
                    style: TextStyle(
                      fontSize: 18,
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                  const SizedBox(height: 8),

                  if (works.isEmpty)
                    const Card(
                      child: Padding(
                        padding: EdgeInsets.all(16),
                        child: Text(

'Hozircha ishlar mavjud emas',
                        ),
                      ),
                    )
